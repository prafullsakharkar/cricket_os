# Phase I gate (`make test-phasei` / CI): the high-risk Phase I modules must
# hold >= 95% line AND branch coverage. These files encode the comparison,
# report and driver logic of shadow mode, where a regression silently misses
# a data-quality mismatch the launch criteria depend on.
#
# `include` (glob patterns) is used instead of `source` because coverage 7.x
# treats a `source` entry ending in `.py` as a *package name* and reports
# "never imported".
[run]
branch = true
include =
    */apps/shadow/compare.py
    */apps/shadow/cards.py
    */apps/shadow/services/driver.py
    */apps/shadow/services/report.py

[report]
fail_under = 95
show_missing = true
skip_covered = true
