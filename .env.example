# Cricket OS — environment variables (copy to `.env` and edit).
# Every variable the app reads is documented here. NEVER commit a real .env.

# --- Django core -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
# Comma-separated. prod refuses to start with an empty list.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# --- Database (PostgreSQL 17, psycopg 3) -----------------------------------
# The app connects with search_path = cricket,public.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cricket
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer
# Host ports published by docker-compose (change if they are already in use).
POSTGRES_PORT=5432

# --- Redis (broker, cache, result backend) ---------------------------------
# Phase E role separation: cache / pubsub / ratelimit / broker / result.
# Locally they share one server on different databases; production may point
# each URL at a separate instance. See docs/REALTIME_AND_CACHING.md.
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/0
PUBSUB_REDIS_URL=redis://localhost:6379/3
RATELIMIT_REDIS_URL=redis://localhost:6379/4
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
REDIS_PORT=6379
# Bounded client timeouts (seconds); a slow Redis must degrade, not block.
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=100
# Set true to run tasks inline (tests use this automatically).
CELERY_TASK_ALWAYS_EAGER=false

# --- API throttling (token bucket per IP / per key) ------------------------
THROTTLE_ANON=120/min
THROTTLE_USER=600/min

# --- Realtime transports (SSE/WS) ------------------------------------------
# SSE heartbeat comment interval (seconds) that keeps proxies from closing an
# idle scoreboard stream.
REALTIME_SSE_HEARTBEAT_SECONDS=15
# Comma-separated allowlist of cross-origin SSE/WS streams (same-origin is
# always allowed; empty = same-origin only).
REALTIME_ALLOWED_ORIGINS=
# Per-node connection caps for SSE/WS streams (per IP / per match / per node).
REALTIME_CONNECTION_CAP_PER_IP=8
REALTIME_CONNECTION_CAP_PER_MATCH=2000
REALTIME_CONNECTION_CAP_PER_NODE=10000
